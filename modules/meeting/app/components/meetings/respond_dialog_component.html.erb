<%=
  render(Primer::Alpha::Dialog.new(id:, title: t("meeting.respond.dialog_title", status: status_label))) do |dialog|
    dialog.with_header(variant: :large)
    dialog.with_body do
      primer_form_with(
        url: respond_project_meeting_path(@project, @meeting),
        method: :post,
        data: { turbo: true }
      ) do
        concat hidden_field_tag(:status, @status)

        concat(
          render(Primer::Alpha::RadioButtonGroup.new(name: "scope", label: t("meeting.respond.scope_label"))) do |group|
            group.radio_button(
              value: "occurrence",
              checked: true,
              label: t("meeting.respond.scope_occurrence")
            )
            group.radio_button(
              value: "series",
              label: t("meeting.respond.scope_series")
            )
          end
        )

        concat(
          render(Primer::Beta::Button.new(type: :submit, scheme: :primary, mt: 3, test_selector: "respond-dialog-submit")) do
            t("meeting.respond.dialog_confirm")
          end
        )
      end
    end
  end
%>
