<%= I18n.t("meeting.email.participation_digest.summary", title: @target.title) %>

<% @responses.each do |response| -%>
<% occurrence_label =
     if @series
       response.meeting.template? ? t("meeting.email.participation_digest.all_future") : format_date(response.meeting.start_time)
     end -%>
- <%= response.name %>: <%= t("meeting_participant.participation_status.#{response.participation_status.underscore}").capitalize %><%= " (#{occurrence_label})" if occurrence_label %><%= " — #{response.comment}" if response.comment.present? %>
<% end -%>

<%= @series ? project_recurring_meeting_url(@target.project, @target) : project_meeting_url(@target.project, @target) %>
