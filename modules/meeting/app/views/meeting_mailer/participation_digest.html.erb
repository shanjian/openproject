<%
  status_colors = {
    "accepted" => "#1a7f37",
    "tentative" => "#9a6700",
    "declined" => "#d1242f"
  }
  target_url =
    if @series
      project_recurring_meeting_url(@target.project, @target)
    else
      project_meeting_url(@target.project, @target)
    end
%>

<%= render layout: "mailer/spacer_table" do %>
  <%= render partial: "mailer/mailer_header",
             locals: {
               user: @user,
               summary: I18n.t("meeting.email.participation_digest.summary", title: @target.title),
               bottom_spacing: false
             } %>

  <%= render layout: "mailer/border_table" do %>
    <tr>
      <%= placeholder_cell("24px", vertical: true) %>
      <td>
        <table>
          <% @responses.each do |response| %>
            <tr>
              <td style="<%= placeholder_text_styles(width: "40%") %>">
                <%= response.name %>
              </td>
              <td style="<%= placeholder_text_styles(color: status_colors[response.participation_status], "font-weight": "bold") %>">
                <%= t("meeting_participant.participation_status.#{response.participation_status.underscore}").capitalize %>
              </td>
              <td style="<%= placeholder_text_styles %>">
                <% if @series %>
                  <% if response.meeting.template? %>
                    <%= t("meeting.email.participation_digest.all_future") %>
                  <% else %>
                    <%= format_date(response.meeting.start_time) %>
                  <% end %>
                <% end %>
              </td>
            </tr>
            <% if response.comment.present? %>
              <tr>
                <td></td>
                <td colspan="2" style="<%= placeholder_text_styles(color: "#57606a") %>">
                  <%= response.comment %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </table>
      </td>
    </tr>
  <% end %>

  <table>
    <tr>
      <%= placeholder_cell("20px", vertical: false) %>
    </tr>
  </table>

  <%= action_button do %>
    <%= link_to I18n.t(:"meeting.email.open_meeting_link"),
                target_url,
                target: "_blank",
                style: "color: #333333; text-decoration: none; font-size: 14px;white-space: nowrap;", rel: "noopener" %>
  <% end %>
<% end %>
