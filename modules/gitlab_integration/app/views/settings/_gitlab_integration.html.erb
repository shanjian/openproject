<fieldset class="form--fieldset">
  <legend class="form--fieldset-legend">
    <%= t("gitlab_integration.settings.admin.title") %>
  </legend>

  <div class="form--field">
    <%= styled_label_tag "settings-gitlab-base-url",
                         t("gitlab_integration.settings.admin.base_url") %>
    <div class="form--field-container">
      <%= styled_text_field_tag "settings[gitlab_base_url]",
                                settings[:gitlab_base_url],
                                id: "settings-gitlab-base-url",
                                placeholder: "https://gitlab.example.com" %>
    </div>
    <div class="form--field-instructions">
      <%= t("gitlab_integration.settings.admin.base_url_hint") %>
    </div>
  </div>
</fieldset>
