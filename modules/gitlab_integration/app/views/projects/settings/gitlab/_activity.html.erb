<fieldset class="form--fieldset">
  <legend class="form--fieldset-legend">
    <%= t("gitlab_integration.settings.activity.title") %>
  </legend>

  <p><%= t("gitlab_integration.settings.activity.intro") %></p>

  <%= styled_form_tag(
        project_settings_gitlab_activity_path(@project),
        method: :patch,
        id: "gitlab_activity"
      ) do %>
    <% activity_settings.each do |setting| %>
      <% event = setting.to_s.delete_prefix("gitlab_comment_on_") %>
      <div class="form--field">
        <div class="form--field-container">
          <label class="form--label-with-check-box">
            <%= hidden_field_tag "gitlab_activity[#{setting}]", "0", id: nil %>
            <%= styled_check_box_tag "gitlab_activity[#{setting}]",
                                     "1",
                                     @project.gitlab_comments_on?(event),
                                     id: "gitlab_activity_#{setting}" %>
            <%= t("gitlab_integration.settings.activity.#{event}") %>
          </label>
        </div>
        <div class="form--field-instructions -labeled-checkbox">
          <%= t("gitlab_integration.settings.activity.#{event}_hint", default: nil) %>
        </div>
      </div>
    <% end %>

    <%= styled_button_tag(t(:button_save), class: "-highlight -with-icon icon-checkmark") %>
  <% end %>
</fieldset>
