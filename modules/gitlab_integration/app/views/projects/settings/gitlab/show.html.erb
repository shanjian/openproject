<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t("gitlab_integration.settings.title") }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project), text: @project.name },
       { href: project_settings_general_path(@project), text: I18n.t(:label_project_settings) },
       t("gitlab_integration.settings.title")]
    )
  end
%>

<% if GitlabIntegration::APIClient.configured_base_url.blank? %>
  <%= render Primer::Beta::Flash.new(scheme: :warning, mb: 3) do %>
    <%= t("gitlab_integration.settings.base_url_missing") %>
  <% end %>
<% end %>

<%= styled_form_tag(
      project_settings_gitlab_path(@project),
      method: :patch,
      id: "edit_project_gitlab_settings"
    ) do %>
  <section class="form--section">
    <div class="form--field">
      <%= label_tag "gitlab_project_settings_gitlab_project_id",
                    t("activerecord.attributes.gitlab_project_settings.gitlab_project_id"),
                    class: "form--label" %>
      <div class="form--field-container">
        <%= text_field_tag "gitlab_project_settings[gitlab_project_id]",
                           @gitlab_project_settings.gitlab_project_id,
                           class: "form--text-field",
                           autocomplete: "off",
                           required: true %>
      </div>
      <div class="form--field-instructions">
        <%= t("gitlab_integration.settings.gitlab_project_id_hint") %>
      </div>
    </div>

    <div class="form--field">
      <%= label_tag "gitlab_project_settings_default_ref",
                    t("activerecord.attributes.gitlab_project_settings.default_ref"),
                    class: "form--label" %>
      <div class="form--field-container">
        <%= text_field_tag "gitlab_project_settings[default_ref]",
                           @gitlab_project_settings.default_ref,
                           class: "form--text-field",
                           autocomplete: "off" %>
      </div>
      <div class="form--field-instructions">
        <%= t("gitlab_integration.settings.default_ref_hint") %>
      </div>
    </div>
  </section>

  <%= styled_button_tag t(:button_save), class: "-highlight -with-icon icon-checkmark" %>
<% end %>
