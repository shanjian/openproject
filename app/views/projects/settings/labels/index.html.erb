<% html_title t(:label_project_settings), t(:label_label_plural) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t(:label_label_plural) }
    header.with_description { t("project_labels.description") }
    header.with_breadcrumbs(
      [{ href: project_overview_path(@project.id), text: @project.name },
       { href: project_settings_general_path(@project), text: t(:label_project_settings) },
       t(:label_label_plural)]
    )
  end
%>

<% if @label_field.nil? %>
  <%= render(Primer::Beta::Blankslate.new) do |blankslate|
        blankslate.with_heading(tag: :h2).with_content(t("project_labels.not_enabled"))
      end %>
<% elsif @project.label_prefix.blank? %>
  <%= render(Primer::Beta::Blankslate.new) do |blankslate|
        blankslate.with_heading(tag: :h2).with_content(t("project_labels.no_prefix"))
      end %>
<% else %>
  <%= styled_form_tag(project_settings_labels_path(@project), method: :post) do %>
    <%= styled_label_tag "custom_option_value", t("project_labels.new_label") %>
    <%= styled_text_field_tag "custom_option[value]", nil,
                              autocomplete: "off",
                              placeholder: "#{@project.label_prefix}-Example" %>
    <%= styled_button_tag t(:button_create), class: "-primary" %>
  <% end %>

  <h3><%= t("project_labels.owned_heading", prefix: @project.label_prefix) %></h3>
  <% if @project_labels.empty? %>
    <p class="form--field-instructions"><%= t("project_labels.none_yet") %></p>
  <% else %>
    <ul class="generic-table--container">
      <% @project_labels.each do |label| %>
        <li>
          <%= form_tag(project_settings_label_path(@project, label), method: :patch, class: "op-inline-form") do %>
            <%= styled_text_field_tag "custom_option[value]", label.value, autocomplete: "off" %>
            <%= styled_button_tag t(:button_save) %>
          <% end %>
          <%= link_to t(:button_delete),
                      project_settings_label_path(@project, label),
                      method: :delete,
                      data: { confirm: t(:text_are_you_sure) } %>
        </li>
      <% end %>
    </ul>
  <% end %>

  <h3><%= t("project_labels.system_heading") %></h3>
  <p class="form--field-instructions"><%= t("project_labels.system_hint") %></p>
  <ul>
    <% @system_labels.each do |label| %>
      <li><%= label.value %></li>
    <% end %>
  </ul>
<% end %>
