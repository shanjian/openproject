<% html_title t(:label_administration), t(:label_label_prefixes) %>

<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { t(:label_label_prefixes) }
    header.with_description { t("label_prefixes.description") }
    header.with_breadcrumbs(
      [{ href: admin_index_path, text: t("label_administration") },
       { href: admin_settings_general_path, text: t(:label_system_settings) },
       t(:label_label_prefixes)]
    )
  end
%>

<%= styled_form_tag(admin_settings_label_prefixes_path, method: :put) do %>
  <div class="generic-table--container">
    <div class="generic-table--results-container">
      <table class="generic-table">
        <colgroup>
          <col opHighlightCol>
          <col opHighlightCol>
          <col opHighlightCol>
        </colgroup>
        <thead>
          <tr>
            <th><%= Project.model_name.human %></th>
            <th><%= Project.human_attribute_name(:identifier) %></th>
            <th><%= Project.human_attribute_name(:label_prefix) %></th>
          </tr>
        </thead>
        <tbody>
          <% @projects.each do |project| %>
            <tr>
              <td><%= link_to project.name, project_path(project) %></td>
              <td><span class="op-mono"><%= project.identifier %></span></td>
              <td>
                <%= text_field_tag "projects[#{project.id}][label_prefix]",
                                   project.label_prefix,
                                   size: 10,
                                   autocomplete: "off",
                                   placeholder: @candidates[project.id] %>
                <% if project.label_prefix.blank? %>
                  <span class="form--field-instructions">
                    <%= @candidates[project.id].present? ? t("label_prefixes.suggested", prefix: @candidates[project.id]) : t("label_prefixes.no_candidate") %>
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <p><%= styled_button_tag t(:button_save), class: "-primary -with-icon icon-checkmark" %></p>
<% end %>
