<%=
  render(Primer::OpenProject::PageHeader.new) do |header|
    header.with_title { @user.name }
    header.with_breadcrumbs(breadcrumb_items)

    header.with_action_button(
      tag: :a,
      mobile_icon: :person,
      mobile_label: t(:label_profile),
      size: :medium,
      href: user_path(@user),
      aria: { label: I18n.t(:label_profile) },
      title: I18n.t(:label_profile)
    ) do |button|
      button.with_leading_visual_icon(icon: :person)
      t(:label_profile)
    end

    can_invite = @current_user.allowed_globally?(:create_user) && @current_user.id != @user.id
    can_reset_password = @current_user.allowed_globally?(:manage_user) && @user.active? && @user.change_password_allowed?

    # Bundled into a single "more" menu action, rather than one action button per item: PageHeader
    # allows a maximum of 5 top-level actions, and Profile + one button per item here (send
    # invitation, copy invitation link, copy password reset link, status change(s), delete) can
    # exceed that for an active, unblocked, deletable user.
    if can_invite || can_reset_password || @current_user.admin?
      header.with_action_menu(
        menu_arguments: { anchor_align: :end },
        button_arguments: {
          icon: "kebab-horizontal",
          "aria-label": t(:label_more),
          data: { "test-selector": "user-more-dropdown-menu" }
        }
      ) do |menu|
        if can_invite
          menu.with_item(
            label: t(:label_send_invitation),
            tag: :a,
            href: resend_invitation_user_path(@user),
            content_arguments: { data: { turbo_method: :post } }
          ) do |item|
            item.with_leading_visual_icon(icon: :mail)
          end

          menu.with_item(
            label: t(:label_copy_invitation_link),
            tag: :a,
            href: invitation_link_user_path(@user),
            content_arguments: { data: { turbo_method: :post } }
          ) do |item|
            item.with_leading_visual_icon(icon: :copy)
          end
        end

        if can_reset_password
          menu.with_item(
            label: t(:label_copy_password_reset_link),
            tag: :a,
            href: password_reset_link_user_path(@user),
            content_arguments: { data: { turbo_method: :post } }
          ) do |item|
            item.with_leading_visual_icon(icon: :key)
          end
        end

        if @current_user.admin? && @current_user.id != @user.id
          iterate_user_statusses(@user) do |title, name|
            menu.with_item(
              label: title,
              tag: :a,
              href: change_status_user_path(@user, { name => "" }),
              content_arguments: { data: { turbo_method: :post } }
            ) do |item|
              item.with_leading_visual_icon(icon: change_user_status_icons[name])
            end
          end
        end

        if @current_user.admin? && Users::DeleteContract.deletion_allowed?(@user, User.current)
          menu.with_item(
            label: t(:button_delete),
            scheme: :danger,
            tag: :a,
            href: deletion_info_user_path(@user),
            content_arguments: { data: { controller: "async-dialog" } }
          ) do |item|
            item.with_leading_visual_icon(icon: :trash)
          end
        end
      end
    end

    helpers.render_tab_header_nav(header, @tabs)
  end
%>
